{
  "expo": {
    "name": "KAMUN 2026",
    "slug": "kamun-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/kamun-logo-v2.png",
    "scheme": "kamun",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/kamun-logo-v2.png",
      "bundleIdentifier": "org.munika.kamun",
      "buildNumber": "1"
    },
    "android": {
      "package": "org.munika.kamun",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/branding/kamun-logo-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./public/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/branding/kamun-logo-v2.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      ["expo-image-picker", { "photosPermission": "Choose a photo to share with KAMUN participants.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
