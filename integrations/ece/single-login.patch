+++ b/packages/core/src/kamun-handoff.ts
@@ -0,0 +1,135 @@
+import { getSettings } from './catalog';
+import { iso } from './engine-common';
+import { checkKamunIdentity } from './kamun-integration';
+import { sha256Hex, createParticipantSession } from './sessions';
+
+const TICKET_LIFETIME_MS = 60_000;
+
+function randomTicket(): string {
+  const bytes = crypto.getRandomValues(new Uint8Array(32));
+  return btoa(String.fromCharCode(...bytes))
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+/** The private KAMUN server may mint a one-minute, single-use participant handoff. */
+export async function issueKamunHandoff(
+  db: D1Database,
+  now: Date,
+  personId: number,
+  revision: string,
+  scope?: string,
+): Promise<{ ticket: string; identity: NonNullable<Awaited<ReturnType<typeof checkKamunIdentity>>> } | null> {
+  if (scope !== undefined && !/^[a-f0-9]{64}$/.test(scope)) return null;
+  if (scope)
+    await db.prepare('INSERT OR IGNORE INTO kamun_session_groups (scope) VALUES (?)').bind(scope).run();
+  const identity = await checkKamunIdentity(db, personId, revision);
+  if (!identity) return null;
+  const ticket = randomTicket();
+  const hash = await sha256Hex(ticket);
+  const expiresAt = iso(new Date(now.getTime() + TICKET_LIFETIME_MS));
+  const [_, inserted] = await db.batch([
+    db.prepare('DELETE FROM kamun_handoff_tickets WHERE expires_at <= ?').bind(iso(now)),
+    db
+      .prepare(
+        `INSERT INTO kamun_handoff_tickets
+      (token_hash, person_id, key_hash, committee_id, seat_id, created_at, expires_at, scope, generation)
+      SELECT ?, p.id, k.key_hash, p.committee_id, p.seat_id, ?, ?, ?,
+        (SELECT generation FROM kamun_session_groups WHERE scope = ?)
+      FROM people p JOIN login_keys k ON k.person_id = p.id AND k.kind = 'code'
+      WHERE p.id = ? AND p.active = 1 AND p.committee_id =
+        (SELECT id FROM committees WHERE short_name = ?)
+        AND (p.seat_id IS NULL AND ? IS NULL OR p.seat_id =
+          (SELECT s.id FROM seats s WHERE s.committee_id = p.committee_id AND s.label = ?))
+      RETURNING token_hash`,
+      )
+      .bind(
+        hash,
+        iso(now),
+        expiresAt,
+        scope ?? null,
+        scope ?? null,
+        personId,
+        identity.committee,
+        identity.seat,
+        identity.seat,
+      ),
+  ]);
+  if (!inserted?.results.length) return null;
+  // A credential can rotate between the identity lookup and INSERT. The ticket is never exposed then.
+  const stillCurrent = await checkKamunIdentity(db, personId, revision);
+  if (!stillCurrent || stillCurrent.committee !== identity.committee || stillCurrent.seat !== identity.seat) {
+    await db.prepare('DELETE FROM kamun_handoff_tickets WHERE token_hash = ?').bind(hash).run();
+    return null;
+  }
+  return { ticket, identity };
+}
+
+/** Atomic DELETE makes replay and two simultaneous exchanges fail after the first one. */
+export async function consumeKamunHandoff(
+  db: D1Database,
+  now: Date,
+  ticket: string,
+): Promise<{ token: string; expiresAt: string } | null> {
+  if (!/^[A-Za-z0-9_-]{43}$/.test(ticket)) return null;
+  const consumed = await db
+    .prepare(
+      `DELETE FROM kamun_handoff_tickets
+    WHERE token_hash = ? AND expires_at > ?
+    RETURNING person_id, key_hash, committee_id, seat_id, scope, generation`,
+    )
+    .bind(await sha256Hex(ticket), iso(now))
+    .first<{
+      person_id: number;
+      key_hash: string;
+      committee_id: number;
+      seat_id: number | null;
+      scope: string | null;
+      generation: number | null;
+    }>();
+  if (!consumed) return null;
+  const settings = await getSettings(db);
+  const expiresAt = settings.get('participant_session_until');
+  if (
+    typeof expiresAt !== 'string' ||
+    !Number.isFinite(Date.parse(expiresAt)) ||
+    Date.parse(expiresAt) <= now.getTime()
+  )
+    return null;
+  const token = await createParticipantSession(
+    db,
+    now,
+    consumed.person_id,
+    expiresAt,
+    {
+      sql: `EXISTS (SELECT 1 FROM people p JOIN login_keys k ON k.person_id = p.id AND k.kind = 'code'
+      WHERE p.id = ? AND p.active = 1 AND k.key_hash = ? AND p.committee_id = ?
+        AND (p.seat_id = ? OR (p.seat_id IS NULL AND ? IS NULL)))`,
+      values: [
+        consumed.person_id,
+        consumed.key_hash,
+        consumed.committee_id,
+        consumed.seat_id,
+        consumed.seat_id,
+      ],
+    },
+    consumed.scope ? { scope: consumed.scope, generation: consumed.generation! } : undefined,
+  );
+  return token ? { token, expiresAt } : null;
+}
+
+/** Invalidates outstanding tickets and sessions together, including exchanges racing with logout. */
+export async function revokeKamunSessions(db: D1Database, scope: string): Promise<void> {
+  if (!/^[a-f0-9]{64}$/.test(scope)) throw new Error('invalid_scope');
+  await db.batch([
+    db
+      .prepare(
+        `INSERT INTO kamun_session_groups (scope, generation) VALUES (?, 1)
+      ON CONFLICT(scope) DO UPDATE SET generation = generation + 1`,
+      )
+      .bind(scope),
+    db.prepare('DELETE FROM kamun_handoff_tickets WHERE scope = ?').bind(scope),
+    db.prepare('DELETE FROM sessions WHERE kamun_scope = ?').bind(scope),
+  ]);
+}
diff --git a/packages/core/src/kamun-integration.ts b/packages/core/src/kamun-integration.ts
new file mode 100644
index 0000000..33d2d9c
--- /dev/null
+++ b/packages/core/src/kamun-integration.ts
@@ -0,0 +1,100 @@
+import { deriveCodeKey } from './identity';
+
+export interface VerifiedKamunIdentity {
+  personId: number;
+  kind: 'delegate' | 'chair';
+  committee: string;
+  seat: string | null;
+  revision: string;
+}
+
+/** Only called by the separately authenticated KAMUN integration endpoint. */
+export async function verifyKamunCode(
+  db: D1Database,
+  pepper: string | undefined,
+  code: string,
+): Promise<VerifiedKamunIdentity | null> {
+  if (!pepper?.trim()) return null;
+  let key: string;
+  try {
+    key = await deriveCodeKey(pepper, code);
+  } catch {
+    return null;
+  }
+  const row = await db
+    .prepare(
+      `SELECT p.id AS personId, p.kind, c.short_name AS committee,
+      s.label AS seat, k.key_hash AS keyHash
+    FROM login_keys k JOIN people p ON p.id = k.person_id
+    JOIN committees c ON c.id = p.committee_id
+    LEFT JOIN seats s ON s.id = p.seat_id
+    WHERE k.kind = 'code' AND k.key_hash = ? AND p.active = 1
+    LIMIT 1`,
+    )
+    .bind(key)
+    .first<{
+      personId: number;
+      kind: 'delegate' | 'chair';
+      committee: string;
+      seat: string | null;
+      keyHash: string;
+    }>();
+  if (!row || (row.kind === 'delegate' && !row.seat)) return null;
+  return {
+    personId: row.personId,
+    kind: row.kind,
+    committee: row.committee,
+    seat: row.kind === 'delegate' ? row.seat : null,
+    revision: await revision(row.keyHash),
+  };
+}
+
+export async function checkKamunIdentity(
+  db: D1Database,
+  personId: number,
+  expectedRevision: string,
+): Promise<VerifiedKamunIdentity | null> {
+  if (!Number.isSafeInteger(personId) || personId < 1 || !/^[0-9a-f]{64}$/.test(expectedRevision))
+    return null;
+  const row = await db
+    .prepare(
+      `SELECT p.id AS personId, p.kind, c.short_name AS committee,
+      s.label AS seat, k.key_hash AS keyHash
+    FROM people p JOIN login_keys k ON k.person_id = p.id AND k.kind = 'code'
+    JOIN committees c ON c.id = p.committee_id
+    LEFT JOIN seats s ON s.id = p.seat_id
+    WHERE p.id = ? AND p.active = 1 LIMIT 1`,
+    )
+    .bind(personId)
+    .first<{
+      personId: number;
+      kind: 'delegate' | 'chair';
+      committee: string;
+      seat: string | null;
+      keyHash: string;
+    }>();
+  if (!row || (row.kind === 'delegate' && !row.seat)) return null;
+  const currentRevision = await revision(row.keyHash);
+  if (currentRevision !== expectedRevision) return null;
+  return {
+    personId: row.personId,
+    kind: row.kind,
+    committee: row.committee,
+    seat: row.kind === 'delegate' ? row.seat : null,
+    revision: currentRevision,
+  };
+}
+
+export async function currentKamunRevision(db: D1Database, personId: number): Promise<string | null> {
+  if (!Number.isSafeInteger(personId) || personId < 1) return null;
+  const row = await db
+    .prepare("SELECT key_hash AS keyHash FROM login_keys WHERE kind = 'code' AND person_id = ?")
+    .bind(personId)
+    .first<{ keyHash: string }>();
+  return row ? revision(row.keyHash) : null;
+}
+
+async function revision(keyHash: string): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(`kamun-revision|${keyHash}`));
+  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
