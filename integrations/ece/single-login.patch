index 0000000..ba7b41b
--- /dev/null
+++ b/packages/core/test/kamun-handoff.test.ts
@@ -0,0 +1,112 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { newCodeFor } from '../src/admin';
+import { consumeKamunHandoff, issueKamunHandoff, revokeKamunSessions } from '../src/kamun-handoff';
+import { verifyKamunCode } from '../src/kamun-integration';
+import { participantFromToken } from '../src/sessions';
+import { addPerson, codeFor, createTestDb, TEST_PEPPER, type TestDb } from './helpers/db';
+
+let testDb: TestDb;
+let personId: number;
+let revision: string;
+const now = new Date('2026-11-14T08:00:00Z');
+beforeAll(async () => {
+  testDb = await createTestDb('kamun-handoff');
+}, 60_000);
+beforeEach(async () => {
+  await testDb.reset();
+  personId = await addPerson(testDb.db, { committee: 'ILO', seat: 'France' });
+  const code = await codeFor(testDb.db, personId);
+  revision = (await verifyKamunCode(testDb.db, TEST_PEPPER, code))!.revision;
+});
+afterAll(() => testDb?.dispose());
+
+describe('KAMUN handoff tickets', () => {
+  it('creates a participant session once for the verified person', async () => {
+    const handoff = await issueKamunHandoff(testDb.db, now, personId, revision);
+    expect(handoff?.identity).toMatchObject({ personId, committee: 'ILO', seat: 'France' });
+    expect(handoff?.ticket).toMatch(/^[A-Za-z0-9_-]{43}$/);
+    const session = await consumeKamunHandoff(testDb.db, now, handoff!.ticket);
+    expect(session).not.toBeNull();
+    expect((await participantFromToken(testDb.db, now, session!.token))?.personId).toBe(personId);
+    expect(await consumeKamunHandoff(testDb.db, now, handoff!.ticket)).toBeNull();
+  });
+
+  it('rejects a forged revision, expiry and simultaneous replay', async () => {
+    expect(await issueKamunHandoff(testDb.db, now, personId, '0'.repeat(64))).toBeNull();
+    const expired = await issueKamunHandoff(testDb.db, now, personId, revision);
+    expect(
+      await consumeKamunHandoff(testDb.db, new Date(now.getTime() + 60_001), expired!.ticket),
+    ).toBeNull();
+    const handoff = await issueKamunHandoff(testDb.db, now, personId, revision);
+    const results = await Promise.allSettled([
+      consumeKamunHandoff(testDb.db, now, handoff!.ticket),
+      consumeKamunHandoff(testDb.db, now, handoff!.ticket),
+    ]);
+    expect(results.filter((r) => r.status === 'fulfilled' && r.value !== null)).toHaveLength(1);
+  });
+
+  it('rejects a rotated code or changed seat before session creation', async () => {
+    const handoff = await issueKamunHandoff(testDb.db, now, personId, revision);
+    await newCodeFor(testDb.db, TEST_PEPPER, now, 'admin', personId);
+    expect(await consumeKamunHandoff(testDb.db, now, handoff!.ticket)).toBeNull();
+
+    const code = await codeFor(testDb.db, personId);
+    const nextRevision = (await verifyKamunCode(testDb.db, TEST_PEPPER, code))!.revision;
+    const next = await issueKamunHandoff(testDb.db, now, personId, nextRevision);
+    await testDb.db
+      .prepare(
+        `UPDATE people SET seat_id =
+      (SELECT s.id FROM seats s JOIN committees c ON c.id = s.committee_id
+       WHERE c.short_name = 'ILO' AND s.label = 'Germany') WHERE id = ?`,
+      )
+      .bind(personId)
+      .run();
+    expect(await consumeKamunHandoff(testDb.db, now, next!.ticket)).toBeNull();
+  });
+});
+
+const scope = 'b'.repeat(64);
+it('remembers a linked session and logout revokes only that KAMUN installation', async () => {
+  const first = await issueKamunHandoff(testDb.db, now, personId, revision, scope);
+  const session = await consumeKamunHandoff(testDb.db, now, first!.ticket);
+  const other = await issueKamunHandoff(testDb.db, now, personId, revision, 'c'.repeat(64));
+  const otherSession = await consumeKamunHandoff(testDb.db, now, other!.ticket);
+  expect(
+    await participantFromToken(testDb.db, new Date(now.getTime() + 86_400_000), session!.token),
+  ).not.toBeNull();
+  const pending = await issueKamunHandoff(testDb.db, now, personId, revision, scope);
+  await revokeKamunSessions(testDb.db, scope);
+  expect(await participantFromToken(testDb.db, now, session!.token)).toBeNull();
+  expect(await consumeKamunHandoff(testDb.db, now, pending!.ticket)).toBeNull();
+  expect(await participantFromToken(testDb.db, now, otherSession!.token)).not.toBeNull();
+  // A later explicit KAMUN login can open ECE again.
+  const next = await issueKamunHandoff(testDb.db, now, personId, revision, scope);
+  expect(await consumeKamunHandoff(testDb.db, now, next!.ticket)).not.toBeNull();
+});
+
+it('logout racing with ticket consumption cannot leave a live session', async () => {
+  const handoff = await issueKamunHandoff(testDb.db, now, personId, revision, scope);
+  const [session] = await Promise.all([
+    consumeKamunHandoff(testDb.db, now, handoff!.ticket),
+    revokeKamunSessions(testDb.db, scope),
+  ]);
+  if (session) expect(await participantFromToken(testDb.db, now, session.token)).toBeNull();
+  expect(
+    await testDb.db
+      .prepare('SELECT COUNT(*) AS count FROM sessions WHERE kamun_scope = ?')
+      .bind(scope)
+      .first('count'),
+  ).toBe(0);
+});
+
+it('opens the individual chair account with its committee and no delegate country', async () => {
+  const chairId = await addPerson(testDb.db, { kind: 'chair', committee: 'ILO' });
+  const chairCode = await codeFor(testDb.db, chairId);
+  const identity = await verifyKamunCode(testDb.db, TEST_PEPPER, chairCode);
+  expect(identity).toMatchObject({ personId: chairId, kind: 'chair', committee: 'ILO', seat: null });
+  const handoff = await issueKamunHandoff(testDb.db, now, chairId, identity!.revision, scope);
+  const session = await consumeKamunHandoff(testDb.db, now, handoff!.ticket);
+  expect((await participantFromToken(testDb.db, now, session!.token))?.personId).toBe(chairId);
+  await revokeKamunSessions(testDb.db, scope);
+  expect(await participantFromToken(testDb.db, now, session!.token)).toBeNull();
+});
