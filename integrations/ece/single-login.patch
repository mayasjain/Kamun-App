+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { newCodeFor } from '../src/admin';
+import { checkKamunIdentity, currentKamunRevision, verifyKamunCode } from '../src/kamun-integration';
+import { addPerson, codeFor, createTestDb, TEST_PEPPER, type TestDb } from './helpers/db';
+
+let testDb: TestDb;
+let personId: number;
+let code: string;
+beforeAll(async () => {
+  testDb = await createTestDb('kamun-integration');
+}, 60_000);
+beforeEach(async () => {
+  await testDb.reset();
+  personId = await addPerson(testDb.db, { committee: 'ILO', seat: 'France' });
+  code = await codeFor(testDb.db, personId);
+});
+afterAll(() => testDb?.dispose());
+
+describe('KAMUN integration identity', () => {
+  it('derives the seat from ECG instead of accepting a claimed seat', async () => {
+    const identity = await verifyKamunCode(testDb.db, TEST_PEPPER, code);
+    expect(identity).toMatchObject({ personId, kind: 'delegate', committee: 'ILO', seat: 'France' });
+    expect(identity?.revision).toMatch(/^[a-f0-9]{64}$/);
+    expect(await checkKamunIdentity(testDb.db, personId, identity!.revision)).toEqual(identity);
+    expect(await currentKamunRevision(testDb.db, personId)).toBe(identity!.revision);
+  });
+
+  it('rejects invalid, rotated, and inactive credentials', async () => {
+    expect(await verifyKamunCode(testDb.db, TEST_PEPPER, 'ZZZZZZZZ')).toBeNull();
+    const original = await verifyKamunCode(testDb.db, TEST_PEPPER, code);
+    const replacement = await newCodeFor(
+      testDb.db,
+      TEST_PEPPER,
+      new Date('2026-11-14T08:00:00Z'),
+      'admin',
+      personId,
+    );
+    expect(replacement.ok).toBe(true);
+    expect(await verifyKamunCode(testDb.db, TEST_PEPPER, code)).toBeNull();
+    expect(await checkKamunIdentity(testDb.db, personId, original!.revision)).toBeNull();
+    expect(await currentKamunRevision(testDb.db, personId)).not.toBe(original!.revision);
+    if (replacement.ok) {
+      expect((await verifyKamunCode(testDb.db, TEST_PEPPER, replacement.value.code))?.revision).not.toBe(
+        original!.revision,
+      );
+    }
+    await testDb.db.prepare('UPDATE people SET active = 0 WHERE id = ?').bind(personId).run();
+    if (replacement.ok)
+      expect(await verifyKamunCode(testDb.db, TEST_PEPPER, replacement.value.code)).toBeNull();
+  });
+});
