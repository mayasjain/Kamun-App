+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { onRequestPost } from '../../../apps/cafe/functions/api/integration/identity';
+import { addPerson, codeFor, createTestDb, TEST_PEPPER, type TestDb } from './helpers/db';
+
+let testDb: TestDb;
+const secret = 'a-long-separate-test-integration-secret-123456789';
+beforeAll(async () => {
+  testDb = await createTestDb('kamun-integration-api');
+}, 60_000);
+afterAll(() => testDb?.dispose());
+
+const invoke = (payload: object, supplied: string | null = secret, protocol = 'https:') => {
+  const request = new Request(`${protocol}//cafe.example.test/api/integration/identity`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      ...(supplied ? { 'X-Kamun-Integration-Key': supplied } : {}),
+    },
+    body: JSON.stringify(payload),
+  });
+  const handler = onRequestPost as unknown as (context: {
+    request: Request;
+    env: { DB: D1Database; LOGIN_PEPPER: string; KAMUN_INTEGRATION_KEY: string; ENVIRONMENT: string };
+  }) => Promise<Response>;
+  return handler({
+    request,
+    env: {
+      DB: testDb.db,
+      LOGIN_PEPPER: TEST_PEPPER,
+      KAMUN_INTEGRATION_KEY: secret,
+      ENVIRONMENT: 'production',
+    },
+  });
+};
+
+describe('private KAMUN verification API', () => {
+  it('requires the server secret and HTTPS', async () => {
+    expect((await invoke({ action: 'verify', code: 'INVALID' }, null)).status).toBe(404);
+    expect((await invoke({ action: 'verify', code: 'INVALID' }, 'wrong')).status).toBe(404);
+    expect((await invoke({ action: 'verify', code: 'INVALID' }, secret, 'http:')).status).toBe(404);
+  });
+
+  it('derives identity and checks a credential revision', async () => {
+    await testDb.reset();
+    const personId = await addPerson(testDb.db, { committee: 'ILO', seat: 'France' });
+    const code = await codeFor(testDb.db, personId);
+    const verify = await invoke({ action: 'verify', code });
+    expect(verify.status).toBe(200);
+    const identity = (await verify.json()) as { personId: number; seat: string; revision: string };
+    expect(identity).toMatchObject({ personId, seat: 'France' });
+    expect((await invoke({ action: 'status', personId, revision: identity.revision })).status).toBe(200);
+    expect((await invoke({ action: 'status', personId, revision: '0'.repeat(64) })).status).toBe(401);
+    const ticket = await invoke({
+      action: 'ticket',
+      scope: 'b'.repeat(64),
+      personId,
+      revision: identity.revision,
+    });
+    expect(ticket.status).toBe(200);
+    expect(((await ticket.json()) as { ticket: string }).ticket).toMatch(/^[A-Za-z0-9_-]{43}$/);
+    expect(
+      (await invoke({ action: 'ticket', scope: 'b'.repeat(64), personId, revision: '0'.repeat(64) })).status,
+    ).toBe(401);
+  });
+});
