+-- One free drink per account for the entire conference. Keep the legacy settings key
+-- for API compatibility. Existing price snapshots, accounts and payments are unchanged.
+INSERT INTO settings (key, value_json) VALUES ('free_drinks_per_day', '1')
+ON CONFLICT(key) DO UPDATE SET value_json = excluded.value_json;
+
+-- Add to existing installations; empty databases get the full menu from base.sql.
+INSERT INTO menu_items (name, description, emoji, price_cents, available, sort)
+SELECT 'Hot chocolate with marshmallows', 'Hot chocolate with steamed oat milk and marshmallows', '🍫', 200, 1, 4
+WHERE EXISTS (SELECT 1 FROM menu_items)
+  AND NOT EXISTS (SELECT 1 FROM menu_items WHERE name = 'Hot chocolate with marshmallows');
+INSERT INTO menu_items (name, description, emoji, price_cents, available, sort)
+SELECT 'Flat White', 'Espresso with steamed oat milk', '☕', 200, 1, 5
+WHERE EXISTS (SELECT 1 FROM menu_items)
+  AND NOT EXISTS (SELECT 1 FROM menu_items WHERE name = 'Flat White');
+UPDATE meta SET value = value + 1 WHERE key = 'version';
