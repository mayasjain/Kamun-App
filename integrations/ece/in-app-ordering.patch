--- /dev/null
+++ b/packages/core/test/kamun-coffee-api.test.ts
@@ -0,0 +1,152 @@
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest';
+import { onRequestPost } from '../../../apps/cafe/functions/api/integration/participant';
+import { buildParticipantState } from '../src/participant-state';
+import { verifyKamunCode } from '../src/kamun-integration';
+import { openRound } from '../src/rounds';
+import { staffBoard } from '../src/views';
+import { setOrderStatus } from '../src/orders';
+import { addPerson, at, codeFor, createTestDb, psl, TEST_PEPPER, type TestDb } from './helpers/db';
+import type { Env } from '../src/env';
+
+let fixture: TestDb;
+const secret = 'test-only-kamun-coffee-integration-key-123456789';
+beforeAll(async () => {
+  fixture = await createTestDb('kamun-coffee-api');
+}, 60_000);
+beforeEach(async () => {
+  await fixture.reset();
+});
+afterAll(() => fixture?.dispose());
+const environment = () => ({ DB: fixture.db, ENVIRONMENT: 'preview', KAMUN_INTEGRATION_KEY: secret }) as Env;
+async function identity(kind: 'delegate' | 'chair' = 'delegate', seat = 'France') {
+  const personId = await addPerson(fixture.db, {
+    committee: 'ILO',
+    kind,
+    ...(kind === 'delegate' ? { seat } : {}),
+  });
+  return (await verifyKamunCode(fixture.db, TEST_PEPPER, await codeFor(fixture.db, personId)))!;
+}
+function invoke(body: object, key: string | null = secret, time = '2026-11-14T09:45') {
+  const request = new Request(`https://coffee.example.test/api/integration/participant?at=${time}`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', ...(key ? { 'X-Kamun-Integration-Key': key } : {}) },
+    body: JSON.stringify(body),
+  });
+  return (onRequestPost as unknown as (context: { request: Request; env: Env }) => Promise<Response>)({
+    request,
+    env: environment(),
+  });
+}
+async function json(response: Response) {
+  return (await response.json()) as {
+    result: {
+      version: number;
+      boundary: string;
+      unchanged: boolean;
+      me: { orders: { id: number; status: string; priceCents: number }[] };
+      order: { id: number };
+    };
+    error?: string;
+  };
+}
+
+describe('KAMUN in-app ordering bridge', () => {
+  it('requires the service key and rejects forged fields and changed identities', async () => {
+    const who = await identity();
+    expect((await invoke({ action: 'state', identity: who }, null)).status).toBe(404);
+    expect((await invoke({ action: 'state', identity: who }, 'wrong')).status).toBe(404);
+    expect((await invoke({ action: 'state', identity: { ...who, revision: '0'.repeat(64) } })).status).toBe(
+      401,
+    );
+    expect((await invoke({ action: 'state', identity: { ...who, seat: 'Brazil' } })).status).toBe(401);
+    expect((await invoke({ action: 'state', identity: { ...who, kind: 'chair' } })).status).toBe(401);
+    expect(
+      (await invoke({ action: 'place_order', identity: who, order: { ...psl(), priceCents: 0 } })).status,
+    ).toBe(400);
+    expect((await invoke({ action: 'state', identity: { ...who, kind: 'kamun_admin' } })).status).toBe(400);
+    await fixture.db.prepare('UPDATE people SET active = 0 WHERE id = ?').bind(who.personId).run();
+    expect((await invoke({ action: 'state', identity: who })).status).toBe(401);
+  });
+
+  it('returns the same state as the cookie API builder and preserves boundary short-circuiting', async () => {
+    const who = await identity();
+    const response = await invoke({ action: 'state', identity: who });
+    expect(response.status).toBe(200);
+    const body = await json(response);
+    expect(body.result).toEqual(await buildParticipantState(environment(), at.satSessionII, who.personId));
+    const unchanged = await json(
+      await invoke({
+        action: 'state',
+        identity: who,
+        query: { v: String(body.result.version), b: body.result.boundary },
+      }),
+    );
+    expect(unchanged.result).toMatchObject({ unchanged: true });
+    const nextBlock = await json(
+      await invoke(
+        {
+          action: 'state',
+          identity: who,
+          query: { v: String(body.result.version), b: body.result.boundary },
+        },
+        secret,
+        '2026-11-14T10:40',
+      ),
+    );
+    expect(nextBlock.result.unchanged).toBe(false);
+  });
+
+  it('deduplicates a lost-response retry and feeds existing staff status changes back to KAMUN', async () => {
+    const who = await identity();
+    await openRound(fixture.db, at.satSessionII, 'barista', { capacity: 1, until: 'block' });
+    const order = psl();
+    const first = await json(await invoke({ action: 'place_order', identity: who, order }));
+    const second = await json(await invoke({ action: 'place_order', identity: who, order }));
+    expect(first.result.order.id).toBe(second.result.order.id);
+    expect(
+      (await staffBoard(fixture.db, at.satSessionII)).orders.some(
+        (order) => order.id === first.result.order.id,
+      ),
+    ).toBe(true);
+    expect(await fixture.db.prepare('SELECT count(*) AS n FROM orders').first('n')).toBe(1);
+    await setOrderStatus(fixture.db, at.satSessionII, 'barista', first.result.order.id, 'ready');
+    const state = await json(await invoke({ action: 'state', identity: who }));
+    expect(state.result.me.orders[0]).toMatchObject({ id: first.result.order.id, status: 'ready' });
+    expect(
+      (await json(await invoke({ action: 'cancel_order', identity: who, orderId: first.result.order.id })))
+        .error,
+    ).toBe('not_cancellable');
+  });
+
+  it('enforces queue capacity and ownership on cancel and only returns your own orders', async () => {
+    const a = await identity();
+    const b = await identity('delegate', 'Brazil');
+    await openRound(fixture.db, at.satSessionII, 'barista', { capacity: 1, until: 'block' });
+    const order = await json(await invoke({ action: 'place_order', identity: a, order: psl() }));
+    expect((await invoke({ action: 'place_order', identity: b, order: psl() })).status).toBe(409);
+    expect((await json(await invoke({ action: 'state', identity: b }))).result.me.orders).toEqual([]);
+    expect(
+      (await json(await invoke({ action: 'cancel_order', identity: b, orderId: order.result.order.id })))
+        .error,
+    ).toBe('not_cancellable');
+    expect(
+      (await invoke({ action: 'cancel_order', identity: a, orderId: order.result.order.id })).status,
+    ).toBe(200);
+  });
+
+  it('preserves chair round bypass, option validation, and server-side free-drink pricing', async () => {
+    const who = await identity('chair');
+    await fixture.db.prepare("UPDATE settings SET value_json = 'true' WHERE key = 'paid_mode'").run();
+    await fixture.db.prepare("UPDATE settings SET value_json = '1' WHERE key = 'free_drinks_per_day'").run();
