diff --git a/packages/core/src/participant-state.ts b/packages/core/src/participant-state.ts
new file mode 100644
index 0000000..69b0585
--- /dev/null
+++ b/packages/core/src/participant-state.ts
@@ -0,0 +1,66 @@
+import { getMenu, getSchedule, getSettings, getVersion, publicSettings } from './catalog';
+import { type Env, isProduction } from './env';
+import { ACTIVE_SQL } from './engine-common';
+import { latestRound, roundState } from './rounds';
+import { fromLocal, scheduleAt, toLocal } from './schedule';
+import { participantView } from './views';
+
+/** Shared by the cookie API and the authenticated KAMUN server bridge. */
+export async function buildParticipantState(
+  env: Env,
+  now: Date,
+  personId: number,
+  query: { v?: string; b?: string } = {},
+) {
+  const db = env.DB;
+  const [version, schedule, round, delivery] = await Promise.all([
+    getVersion(db),
+    getSchedule(db),
+    latestRound(db),
+    // Orders retain their delivery deadlines when the admin edits the schedule afterwards.
+    db
+      .prepare(
+        `SELECT MAX(CASE WHEN deliver_until <= ?1 THEN deliver_until END) AS epoch,
+                         MIN(CASE WHEN deliver_until > ?1 THEN deliver_until END) AS next
+                    FROM orders WHERE person_id = ?2 AND fulfilment = 'delivery'
+                      AND status IN ${ACTIVE_SQL} AND deliver_until IS NOT NULL`,
+      )
+      .bind(now.toISOString(), personId)
+      .first<{ epoch: string | null; next: string | null }>(),
+  ]);
+  const sched = scheduleAt(schedule, now);
+  const rs = round ? roundState(round, now) : null;
+  const local = toLocal(now);
+  // Advance the calendar day, then convert its midnight in Berlin (also correct across DST).
+  const nextDay = new Date(Date.parse(`${local.day}T00:00:00Z`) + 86_400_000).toISOString().slice(0, 10);
+  const midnight = fromLocal(nextDay, '00:00').toISOString();
+  const boundary = `${personId}.${local.day}.${sched.current?.id ?? 0}.${rs?.id ?? 0}.${rs?.open ? 1 : 0}.${delivery?.epoch ?? '0'}`;
+  const nextBoundaryAt =
+    [sched.nextBoundaryAt, rs?.open ? rs.autoCloseAt : null, delivery?.next, midnight]
+      .filter((x): x is string => !!x)
+      .sort()[0] ?? null;
+
+  if (query.v === String(version) && query.b === boundary) {
+    return { unchanged: true as const, version, boundary, nextBoundaryAt };
+  }
+  const [settings, menu, me] = await Promise.all([
+    getSettings(db),
+    getMenu(db),
+    participantView(db, now, personId),
+  ]);
+  if (!me) return null;
+  return {
+    unchanged: false as const,
+    version,
+    boundary,
+    nextBoundaryAt,
+    environment: env.ENVIRONMENT,
+    timeTravel: !isProduction(env),
+    now: now.toISOString(),
+    nowLocal: local,
+    settings: publicSettings(settings),
+    schedule: { blocks: schedule.filter((b) => b.enabled), ...sched },
+    menu,
+    me,
+  };
+}
diff --git a/packages/core/test/kamun-coffee-api.test.ts b/packages/core/test/kamun-coffee-api.test.ts
