index 0000000..c45f3d3
--- /dev/null
+++ b/apps/cafe/functions/api/integration/participant.ts
@@ -0,0 +1,121 @@
+import { z } from 'zod';
+import {
+  buildParticipantState,
+  cancelOwnOrder,
+  checkKamunIdentity,
+  isParticipantDataPurged,
+  orderInputSchema,
+  placeOrder,
+  requestNow,
+  type Env,
+  type PlaceOrderError,
+} from '@covfefe/core';
+
+const identitySchema = z
+  .object({
+    personId: z.number().int().positive(),
+    revision: z.string().regex(/^[a-f0-9]{64}$/),
+    kind: z.enum(['delegate', 'chair']),
+    committee: z.string().min(1).max(20),
+    seat: z.string().max(100).nullable(),
+  })
+  .strict();
+const inputSchema = z.discriminatedUnion('action', [
+  z
+    .object({
+      action: z.literal('state'),
+      identity: identitySchema,
+      query: z
+        .object({ v: z.string().max(30).optional(), b: z.string().max(300).optional() })
+        .strict()
+        .optional(),
+    })
+    .strict(),
+  z
+    .object({ action: z.literal('place_order'), identity: identitySchema, order: orderInputSchema.strict() })
+    .strict(),
+  z
+    .object({
+      action: z.literal('cancel_order'),
+      identity: identitySchema,
+      orderId: z.number().int().positive(),
+    })
+    .strict(),
+]);
+const headers = {
+  'Cache-Control': 'no-store',
+  'Content-Type': 'application/json; charset=utf-8',
+  'X-Content-Type-Options': 'nosniff',
+  'Content-Security-Policy': "default-src 'none'; frame-ancestors 'none'",
+};
+const reply = (body: object, status = 200) => new Response(JSON.stringify(body), { status, headers });
+async function authenticated(request: Request, env: Env) {
+  const actual = request.headers.get('X-Kamun-Integration-Key');
+  const expected = env.KAMUN_INTEGRATION_KEY;
+  if (!actual || !expected || expected.length < 32) return false;
+  const digest = (text: string) => crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
+  const [a, b] = await Promise.all([digest(actual), digest(expected)]);
+  const left = new Uint8Array(a),
+    right = new Uint8Array(b);
+  let difference = 0;
+  for (let i = 0; i < left.length; i++) difference |= left[i]! ^ right[i]!;
+  return difference === 0;
+}
+const orderStatus: Partial<Record<PlaceOrderError, number>> = {
+  invalid_input: 400,
+  note_too_long: 400,
+  person_inactive: 401,
+};
+
+/** Server-to-server only. Never consumes browser cookies or permits arbitrary API forwarding. */
+export const onRequestPost: PagesFunction<Env> = async ({ request, env }) => {
+  if (
+    (new URL(request.url).protocol !== 'https:' && env.ENVIRONMENT !== 'development') ||
+    !(await authenticated(request, env))
+  )
+    return reply({ error: 'not_found' }, 404);
+  if (!/^application\/json(?:\s*;|$)/i.test(request.headers.get('Content-Type') ?? ''))
+    return reply({ error: 'invalid_input' }, 400);
+  const raw = await request.text();
+  if (raw.length > 4096) return reply({ error: 'invalid_input' }, 400);
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    return reply({ error: 'invalid_input' }, 400);
+  }
+  const input = inputSchema.safeParse(parsed);
+  if (!input.success) return reply({ error: 'invalid_input' }, 400);
+  try {
+    if (await isParticipantDataPurged(env.DB)) return reply({ error: 'data_purged' }, 410);
+    const data = input.data;
+    const identity = await checkKamunIdentity(env.DB, data.identity.personId, data.identity.revision);
+    if (
+      !identity ||
+      identity.kind === 'kamun_admin' ||
+      identity.kind !== data.identity.kind ||
+      identity.committee !== data.identity.committee ||
+      identity.seat !== data.identity.seat
+    )
+      return reply({ error: 'inactive' }, 401);
+    // requestNow ignores time travel in production; only local/preview fixtures can supply it.
+    const now = requestNow(env, new URL(request.url).searchParams.get('at') ?? undefined);
+    if (data.action === 'state') {
+      const state = await buildParticipantState(env, now, identity.personId, data.query);
+      return state ? reply({ identity, result: state }) : reply({ error: 'inactive' }, 401);
+    }
+    if (data.action === 'place_order') {
+      const result = await placeOrder(env.DB, now, identity.personId, data.order);
+      return result.ok
+        ? reply({ identity, result: { order: result.value } }, 201)
+        : reply({ identity, error: result.error }, orderStatus[result.error] ?? 409);
+    }
+    const result = await cancelOwnOrder(env.DB, now, identity.personId, data.orderId);
+    return result.ok
+      ? reply({ identity, result: { ok: true } })
+      : reply({ identity, error: result.error }, 409);
+  } catch {
+    // Don't log the integration key, participant identity, or order contents.
+    return reply({ error: 'unavailable' }, 503);
+  }
+};
