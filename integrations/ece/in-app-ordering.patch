+// Stage the participant-only additive KAMUN bridge without running migrations or changing staff.
+import { cpSync, mkdirSync, writeFileSync } from 'node:fs';
+import path from 'node:path';
+import { root, run } from './lib.mjs';
+import { readProduction, productionVars, productionEnv } from './prod-config.mjs';
+import { safeWranglerEnv } from './demo-config.mjs';
+const config = readProduction();
+const stage = path.join(root, '.deploy', 'kamun-inapp-participant');
+mkdirSync(stage, { recursive: true });
+cpSync(path.join(root, 'apps/cafe/dist'), path.join(stage, 'dist'), { recursive: true });
+cpSync(path.join(root, 'apps/cafe/functions'), path.join(stage, 'functions'), { recursive: true });
+writeFileSync(
+  path.join(stage, 'wrangler.json'),
+  JSON.stringify(
+    {
+      name: config.projects.cafe,
+      pages_build_output_dir: 'dist',
+      compatibility_date: '2026-10-01',
+      vars: productionVars(config, 'cafe'),
+      d1_databases: [{ binding: 'DB', database_name: config.database.name, database_id: config.database.id }],
+    },
+    null,
+    2,
+  ) + '\n',
+);
+console.log('Staged participant-only release; no database or staff changes.');
+
+if (process.argv.includes('--deploy')) {
+  run(
+    'wrangler',
+    ['pages', 'deploy', '--project-name', config.projects.cafe, '--branch', 'main', '--commit-dirty=true'],
+    {
+      cwd: stage,
+      env: productionEnv(config, safeWranglerEnv()),
+    },
+  );
+}
